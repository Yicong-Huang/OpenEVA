            return
        print(_dim("Message sent (%d chars)" % len(text)))
        return
    if wait_until_ready(name, args.timeout):
        paste_text(name, text)
        if _emit_json_if_requested(args, {"session": name, "sent": len(text)}):
            return
        print(_dim("Message sent (%d chars)" % len(text)))
    else:
        _error("Session %s did not become ready within %ds" % (name, args.timeout),
               hint="Pass --no-wait to skip the readiness check.")



def cmd_audit(args):
    """Run the data-integrity audit and print findings.

    Default: human-readable summary + per-finding lines, exit 0 when
    nothing was found, exit 2 when any finding is severity 'error'.
    `--fix` applies the registered repairs (orphans get deleted) then
    re-runs the audit so the user sees the post-fix state.

    Filtering: `--kind <k>` can be repeated to keep multiple kinds.
    `--severity <s>` keeps only that severity. Both are validated
    against the registered enum so a typo errors loudly instead of
    silently filtering to zero findings.
    """
    from common import audit as _audit

    # `--list-kinds` is a quick lookup: print the enum, exit 0.
    if getattr(args, "list_kinds", False):
        if _emit_json_if_requested(args, {
            "kinds": list(_audit.KNOWN_KINDS),
            "severities": list(_audit.KNOWN_SEVERITIES),
        }):
            return
        print(_bold("audit kinds:"))
        for k in _audit.KNOWN_KINDS:
            print("  %s" % k)
        print(_bold("severities:"))
        for s in _audit.KNOWN_SEVERITIES:
            print("  %s" % s)
        return

    # Validate filters before running so a typo errors immediately
    # rather than after the (potentially slow) full audit scan.
    kinds: list[str] = []
    if args.kind:
        # `args.kind` may be a list (action="append") or a single
        # string (legacy callers); normalise.
        raw_kinds = args.kind if isinstance(args.kind, list) else [args.kind]
        for k in raw_kinds:
            if k not in _audit.KNOWN_KINDS:
                _error(
                    "unknown audit kind: %r" % k,
                    hint="Run `eva-cli audit --list-kinds` to see valid kinds.",
                )
            kinds.append(k)
    if getattr(args, "severity", None):
        if args.severity not in _audit.KNOWN_SEVERITIES:
            _error(
                "unknown audit severity: %r" % args.severity,
                hint="Valid severities: %s"
                     % ", ".join(_audit.KNOWN_SEVERITIES),
            )

    def _apply_filters(findings_list: list[dict]) -> list[dict]:
        out = findings_list
        if kinds:
            kset = set(kinds)
            out = [f for f in out if f.get("kind") in kset]
        if getattr(args, "severity", None):
            out = [f for f in out if f.get("severity") == args.severity]
        return out

    result = _audit.run_audit()
    findings = _apply_filters(result["findings"])

    fixed_summary = None
    if args.fix and findings:
        fixed_summary = _audit.fix_all(findings)
        # Re-scan so the displayed list reflects post-fix state.
        result = _audit.run_audit()
        findings = _apply_filters(result["findings"])

    if _emit_json_if_requested(args, {
        "findings": findings,
        "summary": result["summary"],
        "fixed": fixed_summary,
    }):
        return

    by_sev = result["summary"].get("by_severity", {})
    filter_parts = []
    if kinds:
        filter_parts.append("kind=" + "|".join(kinds))
    if getattr(args, "severity", None):
        filter_parts.append("severity=" + args.severity)
    if filter_parts:
        # Filter active: show "N of TOTAL matching <filters>" so the
        # mismatch between the displayed list and the global summary
        # doesn't look like a bug.
        headline = "%d of %d finding(s) match %s" % (
            len(findings), result["summary"]["total"],
            "  ".join(filter_parts),
        )
    else:
        headline = (
            "%d finding(s)  errors=%d  warns=%d  infos=%d" % (
                result["summary"]["total"],
                by_sev.get("error", 0), by_sev.get("warn", 0), by_sev.get("info", 0),
            )
        )
    if fixed_summary:
        headline += "  (fixed=%d skipped=%d)" % (
            fixed_summary["fixed"], fixed_summary["skipped"])
    print(_bold(headline))

    if not findings:
        print(_dim("No data-integrity issues found."))
        return

    sev_color = {"error": _red, "warn": _cyan, "info": _dim}
    for f in findings:
        col = sev_color.get(f["severity"], _dim)
        tag = col("[%s]" % f["severity"])
        kind = _bold(f["kind"])
        fixable = _dim(" (fixable)") if f.get("fixable") else ""
        print("%s %s%s  %s" % (tag, kind, fixable, f["message"]))

    # Exit non-zero if any error-severity finding remains so the user
    # can wire this into CI / git hooks.
    if by_sev.get("error", 0) > 0:
        sys.exit(2)



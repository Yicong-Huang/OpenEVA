class _EvaCLIParser(argparse.ArgumentParser):
    """Custom parser with friendlier error messages.

    1. Top-level invalid subcommand prints 'Unknown command' rather
       than argparse's verbose `invalid choice` listing every command.
    2. `unrecognized arguments` for project/task flags hints that
       those are positionals on this CLI -- common confusion because
       `--project` is conventional in many tools.
    Argument-level `choices=` failures (e.g. `--status bogus`) are
    left to argparse's default handler so the user sees the full list
    of valid choices."""

    # Flags that callers commonly try, expecting them to be optional.
    _POSITIONAL_FLAG_HINTS = {
        "--project": "the project id is the FIRST positional arg",
        "--task-id": "the task id is the SECOND positional arg",
        "--task_id": "the task id is the SECOND positional arg",
    }

    def error(self, message):
        import re
        # argparse formats the top-level invalid command as
        # `argument command: invalid choice: 'X' (...)`. Only intercept
        # when the offending argument IS `command` -- any other
        # `invalid choice` (e.g. `--status`, `--type`) falls through to
        # argparse's own error path which prints the valid choices list.
        if "argument command:" in message and "invalid choice" in message:
            m = re.search(r"invalid choice: '([^']*)'", message)
            cmd = m.group(1) if m else "?"
            print("Unknown command: %s. Run 'eva-cli help' for usage."
                  % cmd, file=sys.stderr)
            sys.exit(1)
        if "unrecognized arguments" in message:
            tokens = message.split("unrecognized arguments:", 1)[-1].split()
            hits = [t for t in tokens if t in self._POSITIONAL_FLAG_HINTS]
            if hits:
                hint = "; ".join(self._POSITIONAL_FLAG_HINTS[t] for t in hits)
                print(f"Error: {message}", file=sys.stderr)
                print(f"Hint: {hint}. Try `<cmd> <project> <task_id> ...` "
                      f"-- run `eva-cli <cmd> --help` for the exact "
                      f"argument order.", file=sys.stderr)
                sys.exit(2)
            # Bare positional tokens (no leading dash) typically mean
            # the user expected a third positional like `description`
            # but the CLI takes those as flags. Surface the flag form
            # rather than just echoing argparse's terse 'unrecognized
            # arguments: foo'.
            bare = [t for t in tokens if not t.startswith("-")]
            if bare:
                preview = " ".join(bare[:3])
                print(f"Error: {message}", file=sys.stderr)
                print(
                    f"Hint: extra positional value(s) {preview!r} -- did "
                    f"you mean to pass them as flags? Common ones are "
                    f"`--description`, `--notes`, `--ticket-id`, "
                    f"`--status`. Run `eva-cli <cmd> --help` for the "
                    f"full flag list.",
                    file=sys.stderr,
                )
                sys.exit(2)
        super().error(message)


def _normalize_argv(argv: list[str]) -> list[str]:
    """Hoist a trailing `--json` (or `-h` / `--help`) to the front so
    both placements work identically.

    Without this, `eva-cli list-projects --json` fails with
    "unrecognized arguments: --json" because argparse only honours
    `--json` on the top-level parser, not the subcommand. Memo item
    #7 from architecture-discussion.md. Keeps `audit --json` working
    too because the audit subparser also accepts `--json` (its own
    declaration) -- argparse merges duplicate `store_true` flags
    cleanly.

    Subcommand `audit` is a special-case exception: it has rich
    per-flag args (`--fix`, `--kind`) that need to STAY positioned
    after the subcommand name. We only hoist `--json`."""
    out = list(argv)
    # Idempotent: no-op when already at the front.
    if out and out[0] == "--json":
        return out
    if "--json" in out:
        out = ["--json"] + [a for a in out if a != "--json"]
    return out


def main():
    parser = build_parser()
    args = parser.parse_args(_normalize_argv(sys.argv[1:]))
    if not args.command:
        parser.print_help()
        sys.exit(0)
    if args.command == "help":
        parser.print_help()
        sys.exit(0)
    handler = _DISPATCH.get(args.command)
    if not handler:
        print("Unknown command: %s. Run 'eva-cli help' for usage."
              % args.command, file=sys.stderr)
        sys.exit(1)
    _ensure_core()
    handler(args)


if __name__ == "__main__":
    main()

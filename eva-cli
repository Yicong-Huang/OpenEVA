#!/usr/bin/env python3
"""eva-cli -- comprehensive CLI for the Eva project dashboard.

Runs against whichever `python3` is first on PATH. The Eva dependency
set (FastAPI, etc.) must be importable from that interpreter. We probe
known venv locations in this order so a fresh checkout just works:

  1. `<repo>/.venv/lib/python*/site-packages` (the canonical layout
     after `python -m venv .venv` from the repo root)
  2. `$EVA_VENV/lib/python*/site-packages` if the env var is set

If neither has the deps, the user gets a single clear error
explaining the two options instead of a cryptic ImportError.

The bootstrap stays restricted to stdlib up to the venv probe so the
shebang's `python3` (which on some systems is 3.6/3.7) can at least
get far enough to give a helpful error. PEP-585 generic syntax like
`list[str]` would crash the script before we ever reach `_error()`,
so this preamble uses old-style generics or untyped containers.
"""
import argparse
import json
import os
# Same pysqlite3 fallback as eva_db.py + app_state.py -- mixing
# stdlib sqlite3 (3.31 on Ubuntu 20.04) with the modern engine
# corrupts the shared WAL.
try:
    from pysqlite3 import dbapi2 as sqlite3
except ImportError:
    import sqlite3
import sys

# Bail early on Python <3.9. The Eva codebase uses PEP-585 generics
# (`list[int]`) and PEP-604 unions (`int | None`) throughout
# `eva_db.py`, so a 3.6 / 3.7 / 3.8 interpreter would crash with
# cryptic SyntaxError on import. Print a one-line hint instead.
if sys.version_info < (3, 9):
    sys.stderr.write(
        "eva-cli requires Python >= 3.9 (you have %d.%d). "
        "Set up a venv with a newer interpreter and either point "
        "EVA_VENV at it or activate it before invoking the CLI.\n"
        % sys.version_info[:2]
    )
    sys.exit(1)

# Add the OSS + every extension's `src/` tree to sys.path.
# `core/src/` is always present; extensions are anything sibling-to-
# core with an `extension.conf` marker (see extensions). The
# scanner is imported AFTER `core/src/` is on the path because the
# scanner itself lives at `core/src/core/extensions.py`.
_ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(_ROOT, "core", "src"))
try:
    from common.extensions import discover as _disc_exts
    for _ext in _disc_exts(_ROOT):
        if _ext.src.is_dir():
            sys.path.insert(0, str(_ext.src))
except Exception:
    # Extension discovery is best-effort; eva-cli core functionality
    # (list-tasks, list-projects, etc.) doesn't depend on any extension,
    # so a broken scanner mustn't crash the CLI before it even parses
    # its argv.
    pass

# Activate venv site-packages if not already in a proper venv. This
# lets the shebang line work with system python while still finding
# fastapi, pydantic, etc. from a project-local or user-level venv.
_CANDIDATE_VENVS = []  # plain list -- see module docstring re: PEP 585.
_repo_venv = os.path.join(_ROOT, ".venv")
if os.path.isdir(_repo_venv):
    _CANDIDATE_VENVS.append(_repo_venv)
_env_venv = os.environ.get("EVA_VENV")
if _env_venv and os.path.isdir(_env_venv):
    _CANDIDATE_VENVS.append(_env_venv)

import glob as _glob  # noqa: E402 -- only loaded when probing venvs
for _venv in _CANDIDATE_VENVS:
    for _sp in _glob.glob(os.path.join(_venv, "lib", "python*/site-packages")):
        if _sp not in sys.path:
            sys.path.insert(0, _sp)

# Lazy-load core modules (they depend on fastapi which requires Python 3.8+).
# help/version commands work even if core/ cannot be imported.
_core_loaded = False
tasks = projects = prs = system = None


def _ensure_core():
    global _core_loaded, tasks, projects, prs, system
    if _core_loaded:
        return
    try:
        from common import tasks as _tasks, projects as _projects, prs as _prs, system as _system
        tasks = _tasks
        projects = _projects
        prs = _prs
        system = _system
        _core_loaded = True
        # Wire CLI-side emit_event to relay through the running server's
        # SSE so the web UI sees `task.created` / `task.updated` / etc.
        # in real time. Best-effort: if no server is running, the relay
        # in app_state.emit_event silently fails and the CLI keeps
        # working (offline use stays supported).
        import app_state as _app_state
        base = os.environ.get("EVA_BASE_URL", "http://localhost:8021").rstrip("/")
        _app_state._event_relay_url = base + "/api/internal/emit-relay"
        # Agents are registered via side-effect on import. Server boot
        # does this in server.py; the CLI runs as a separate Python
        # process so its registry starts empty -- `open-session` etc.
        # would fail with "No agent registered". Mirror server.py:
        # OSS `core/src/agents/` + every extension's `src/agents/`.
        try:
            from common import agent as _agent_registry
            from common.extensions import discover as _discover_extensions
            _agent_dirs = [_app_state.REPO_ROOT / "core" / "src" / "agents"]
            for _ext in _discover_extensions(_app_state.REPO_ROOT):
                if _ext.agents_dir.is_dir():
                    _agent_dirs.append(_ext.agents_dir)
            _agent_registry.discover_agents(*_agent_dirs)
        except Exception as _e:
            # Best-effort: commands that don't need an agent (list-tasks,
            # get-task, ...) keep working even if discovery breaks.
            print(f"[init] agent discovery skipped: {_e}", file=sys.stderr)
        # Run each extension's `seed.py` so extension-side wiring
        # (DB methods installed on EvaDB, plugin registrations, etc.)
        # is in place before any CLI command runs. The server does
        # the same at boot via `_run_seed_files`; CLI runs in its
        # own process so it needs its own pass. Best-effort.
        try:
            from common.extensions import (
                discover as _discover_exts2,
                run_seed_files as _run_seed_files,
            )
            _run_seed_files(list(_discover_exts2(_app_state.REPO_ROOT)))
        except Exception as _e:
            print(f"[init] extension seed skipped: {_e}", file=sys.stderr)
    except Exception as e:
        print(f"Error: cannot load core modules: {e}", file=sys.stderr)
        print(file=sys.stderr)
        print("Eva needs FastAPI + Pydantic on the import path. Try one of:",
              file=sys.stderr)
        print("  - python -m venv .venv && .venv/bin/pip install -r requirements.txt",
              file=sys.stderr)
        print("  - EVA_VENV=/path/to/venv eva-cli ...", file=sys.stderr)
        print("  - .venv/bin/python eva-cli ...   (run with the venv's python)",
              file=sys.stderr)
        sys.exit(1)


# ====================================================================
# ANSI color helpers
# ====================================================================

_COLOR = sys.stdout.isatty()


def _c(code, text):
    if not _COLOR:
        return str(text)
    return "\033[%sm%s\033[0m" % (code, text)


def _bold(t):
    return _c("1", t)


def _green(t):
    return _c("32", t)


def _yellow(t):
    return _c("33", t)


def _red(t):
    return _c("31", t)


def _cyan(t):
    return _c("36", t)


def _dim(t):
    return _c("2", t)


def _error(msg, hint=None, code=1):
    """Print a standardized error message and exit.

    Format: "Error: <msg>" on stderr, always red. Optional dim hint on the
    next line. Always exits with the given code (default 1).
    """
    prefix = "" if msg.lower().startswith("error") else "Error: "
    print(_red(prefix + msg), file=sys.stderr)
    if hint:
        print(_dim(hint), file=sys.stderr)
    sys.exit(code)


# Shared hints reused by multiple "not found" error sites. Centralising them
# keeps the wording consistent and makes it cheap to update the suggested
# remediation command in one spot.
_HINT_LIST_PROJECTS = "Run `eva-cli list-projects` to see valid project ids."


# Canonical task status values sourced from the single source of truth
# in eva_db.VALID_STATUSES (re-exported by tasks as
# VALID_TASK_STATUSES). CLI, HTTP routes, MCP and the sqlite CHECK
# constraint all agree on the same set -- touching one end auto-
# propagates. Kept sorted so `--help` output is stable.
# (eva_db is stdlib-only so importing at module scope doesn't break the
# lazy-core-load contract above.)
from eva_db import VALID_STATUSES as _VALID_STATUSES
_TASK_STATUS_CHOICES = sorted(_VALID_STATUSES)

# Accepted task types: 9 canonical spellings + 3 conventional-commit
# aliases. The aliases (`feat` -> `feature`, `doc` -> `docs`,
# `bug` -> `fix`) are normalised at the write boundary in
# `tasks.canonicalize_task_type`, so the DB only ever stores
# canonical values. Listing both forms in argparse means the CLI
# accepts the short conventional-commit spellings out of the box.
_TASK_TYPE_CANONICAL = [
    "feature", "fix", "test", "refactor", "docs",
    "chore", "perf", "benchmark", "cleanup",
]
_TASK_TYPE_ALIASES = ["feat", "doc", "bug"]
_TASK_TYPE_CHOICES = _TASK_TYPE_CANONICAL + _TASK_TYPE_ALIASES


def _hint_list_tasks(project):
    return "Run `eva-cli list-tasks %s` to see valid task ids." % project


def _err_project_not_found(project):
    _error("project '%s' not found" % project, hint=_HINT_LIST_PROJECTS)


def _err_task_not_found(project, task_id):
    _error("task '%s' not found in project '%s'" % (task_id, project),
           hint=_hint_list_tasks(project))


def _emit_json_if_requested(args, obj):
    """Emit obj as indented JSON when the caller asked for --json.

    Returns True if the caller should early-return (i.e. JSON was printed),
    False when the caller should continue rendering human output.
    """
    if getattr(args, "json", False):
        print(json.dumps(obj, indent=2))
        return True
    return False


def _emit_jsonl_event(args, event):
    """In --json mode, emit one compact JSON object per line (JSONL).

    Returns True if the caller should skip human rendering for this event.
    Typical use for streaming commands like sync-prs: after each progress
    event, call this first to short-circuit when JSON output was requested.
    """
    if getattr(args, "json", False):
        print(json.dumps(event))
        return True
    return False


def _status_color(status):
    s = (status or "").lower()
    if s in ("done", "merged", "ok"):
        return _green(status)
    if s in ("in_progress", "in_review", "warning", "open"):
        return _yellow(status)
    if s in ("closed", "expired", "error", "blocked"):
        return _red(status)
    return status or ""


# ====================================================================
# Table formatter
# ====================================================================

def _strip_ansi(s):
    """Remove SGR escape sequences so we can measure visible width."""
    plain = s
    while "\033[" in plain:
        start = plain.index("\033[")
        end = plain.index("m", start) + 1
        plain = plain[:start] + plain[end:]
    return plain


def _table(headers, rows, min_widths=None):
    """Print a simple table with padding. Strips ANSI when measuring widths."""
    widths = list(min_widths or [0] * len(headers))
    for i, h in enumerate(headers):
        if i < len(widths):
            widths[i] = max(widths[i], len(h))
    for row in rows:
        for i, cell in enumerate(row):
            if i < len(widths):
                widths[i] = max(widths[i], len(_strip_ansi(cell)))

    def _fmt_row(cells):
        parts = []
        for i, cell in enumerate(cells):
            w = widths[i] if i < len(widths) else 0
            pad = w - len(_strip_ansi(cell))
            parts.append(cell + " " * max(pad, 0))
        return "  ".join(parts)

    lines = [_fmt_row([_bold(h) for h in headers])]
    lines.append("  ".join("-" * w for w in widths))
    for row in rows:
        lines.append(_fmt_row(list(row)))
    return "\n".join(lines)



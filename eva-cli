def _load_cli_addons(subparsers, dispatch):
    """Discover and load `<ext>/src/cli.py` from every sibling-of-core
    folder bearing an `extension.conf` marker. Each addon's
    `register(subparsers, dispatch)` runs once at parser build time.

    Failures log to stderr and are otherwise swallowed: a broken addon
    must not prevent eva-cli from running its core commands.
    """
    import importlib.util
    from pathlib import Path as _Path
    repo_root = _Path(_ROOT)
    for marker in sorted(repo_root.glob("*/extension.conf")):
        ext_dir = marker.parent
        if ext_dir.name == "core":
            continue
        cli_path = ext_dir / "src" / "cli.py"
        if not cli_path.is_file():
            continue
        try:
            spec = importlib.util.spec_from_file_location(
                f"_eva_cli_addon_{ext_dir.name}", str(cli_path),
            )
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            if hasattr(mod, "register"):
                # Pass the running eva-cli module so the addon can
                # call internal helpers (_error, _green, _dim,
                # _emit_json_if_requested, _ensure_core, ...) without
                # re-implementing them.
                mod.register(subparsers, dispatch, sys.modules[__name__])
        except Exception as e:
            print(
                f"[cli-addon] {ext_dir.name}: {e}", file=sys.stderr,
            )



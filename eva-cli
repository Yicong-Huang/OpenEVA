    it. Same delivery path as `open-session --prompt` -- waits for the
    TUI to be ready (unless --no-wait), then writes the message via a
    bracketed-paste sequence + Enter so agent sees one atomic input."""
    from adapters.tmux import paste_text, wait_until_ready, session_exists
    name = args.session_name
    if not session_exists(name):
        _error("Session not found: %s" % name,
               hint="Run `eva-cli list-sessions` to see active sessions.")
    text = args.message
    if args.no_wait:
        paste_text(name, text)

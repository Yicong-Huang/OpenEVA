# -- PR commands --

def cmd_list_prs(args):
    result = prs.list_all_prs(status=args.status or "",
                              search=args.search or "")
    groups = result.get("groups", {})
    # Optional --project filter: applied client-side so we don't have to
    # change the core API. Unknown project -> empty result, not an error
    # (matches how --status / --search behave when no match).
    project_filter = getattr(args, "project", "") or ""
    if project_filter:
        groups = {k: v for k, v in groups.items() if k == project_filter}
        result = {"groups": groups}
    if _emit_json_if_requested(args, result): return
    if not groups:
        print(_dim("No PRs found."))
        return
    for pid, group in groups.items():
        print(_bold("\n%s" % group.get("name", pid)))
        for pr in group.get("prs", []):
            status = pr.get("status", "?")
            ci = pr.get("ci_status", "")
            rv = pr.get("review_status", "")
            print("  #%-6s %s  %s  ci=%s review=%s" % (
                pr["number"],
                _status_color(status),
                (pr.get("title", "") or "")[:50],
                ci or "-", rv or "-"))


def cmd_add_pr(args):
    try:
        result = prs.add_pr(
            args.project, args.task_id,
            number=args.number, url=args.url,
            status=args.status or "open",
            title=args.title or "",
        )
    except ValueError as e:
        # `prs.add_pr` raises ValueError when `title` is empty. Bubble
        # up as a clean error + hint instead of a traceback; `--title` is
        # optional at the argparse layer so the user wouldn't otherwise
        # learn it's effectively required.
        _error(str(e),
               hint="Pass `--title \"<PR title>\"` or fetch it first with "
                    "`eva-cli pr-detail <repo> %d`." % args.number)
    if result is None:
        _err_task_not_found(args.project, args.task_id)
    if _emit_json_if_requested(args, {"added": True, "number": args.number}): return
    print(_green("Added PR #%d to task '%s'" % (args.number, args.task_id)))


def cmd_remove_pr(args):
    result = prs.remove_pr(args.project, args.task_id, args.number)
    if result is None:
        _err_task_not_found(args.project, args.task_id)
    if result is False:
        _error("PR #%d not found on task '%s'" % (args.number, args.task_id),

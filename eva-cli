def cmd_append_review_history(args):
    """Append one terse line to a review's history timeline (<=100 chars).

    Primary caller is the agent itself -- the `review-pr` action prompt
    ends with a note to call this command when the pass is finished.
    That way even if the agent-hook integration missed events, the user
    still sees "what I did last time on this PR" when they reopen the queue.
    """
    _ensure_core()
    import app_state
    text = (args.text or "").strip()
    if not text:
        _error("history text is empty",
               hint='Example: eva-cli append-review-history '
                    '"https://github.com/acme/widgets/pull/42" '
                    '"approved after a skim"')
    try:
        entry = app_state._db.append_review_history(
            args.url, text, source=(args.source or "manual"))
    except ValueError as e:
        msg = str(e)
        if "not found" in msg:
            _error(msg,
                   hint="Check the URL is exact; only PRs already in the "
                        "review queue (review_prs) accept history.")
        if "chars" in msg:
            _error(msg,
                   hint="Trim to one terse line; longer context belongs in "
                        "the PR review comment itself.")
        _error(msg)
    if _emit_json_if_requested(args, entry): return
    print(_green("review-history+ ")
          + _dim("[%s]" % entry["ts"]) + " " + entry["text"])



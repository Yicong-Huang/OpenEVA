# -- Task commands --

def cmd_list_projects(args):
    proj_list = projects.list_projects()
    if _emit_json_if_requested(args, proj_list): return
    if not proj_list:
        print(_dim("No projects found."))
        return
    rows = []
    for p in proj_list:
        rows.append((
            _bold(p["id"]),
            p.get("name", ""),
            _status_color("%d%%" % p.get("progress", 0)),
            str(p.get("total_tasks", 0)),
            "%s/%s/%s" % (
                p.get("task_counts", {}).get("done", 0),
                p.get("task_counts", {}).get("in_progress", 0),
                p.get("task_counts", {}).get("not_started", 0),
            ),
        ))
    print(_table(["ID", "Name", "Progress", "Tasks", "Done/WIP/Todo"], rows))


def cmd_update_project(args):
    import app_state
    fields = {}
    if args.name is not None: fields["name"] = args.name
    if args.description is not None: fields["description"] = args.description
    if args.repo is not None: fields["repo"] = args.repo
    if args.jira is not None: fields["jira"] = args.jira
    if args.has_tickets is not None: fields["has_tickets"] = args.has_tickets.lower() in ("true", "1", "yes")
    if args.design_doc is not None: fields["design_doc"] = args.design_doc
    if not fields:
        _error("no fields to update")
    result = app_state._db.update_project(args.project, **fields)
    if not result:
        _err_project_not_found(args.project)
    if _emit_json_if_requested(args, result): return
    print(_green("Updated project '%s'" % args.project))


def cmd_list_tasks(args):
    proj = projects.get_project(args.project)
    if not proj:
        _err_project_not_found(args.project)
    task_dict = proj.get("tasks", {})
    if _emit_json_if_requested(args, task_dict): return
    if not task_dict:
        print(_dim("No tasks in project '%s'." % args.project))
        return
    rows = []
    for tid, t in sorted(task_dict.items()):
        rows.append((
            _status_color(t.get("status", "?")),
            tid,
            (t.get("description", "") or "")[:60],
        ))
    print(_table(["Status", "Task ID", "Description"], rows,
                 min_widths=[12, 30, 40]))


def _print_task_detail(t, title_line=None, show_effective=False,
                       show_priority_group=False, show_ci_review=False,
                       pr_title_width=60):
    """Print a single task's fields in the batch/get detail format.

    Unified between `cmd_fetch_tasks` and `cmd_get_task` -- callers choose
    which optional fields to surface via the flags.
    """
    if title_line is not None:
        print(title_line)
    print("  status: %s" % _status_color(t.get("status", "?")))
    if show_effective and t.get("effective_status") != t.get("status"):
        print("  effective: %s" % _status_color(t.get("effective_status", "")))
    print("  description: %s" % (t.get("description", "") or ""))
    if t.get("type"):
        print("  type: %s" % t["type"])
    if show_priority_group:
        if t.get("priority", 5) != 5:
            print("  priority: %s" % t["priority"])
        grp = t.get("group_name") or t.get("group")
        if grp:
            print("  group: %s" % grp)
    ticket = t.get("ticket") or {}
    if ticket.get("id"):
        print("  ticket: %s (%s)" % (ticket["id"], ticket.get("url", "")))
    if show_priority_group:
        deps = t.get("dependencies", [])
        if deps:
            print("  dependencies: %s" % ", ".join(deps))
    if t.get("notes"):
        print("  notes: %s" % t["notes"])
    for pr in t.get("prs", []):
        title = (pr.get("title", "") or "")[:pr_title_width]
        if show_ci_review:
            ci = pr.get("ci_status", "")
            rv = pr.get("review_status", "")
            print("  PR #%s [%s] %s  ci=%s review=%s" % (
                pr["number"], pr.get("status", "?"), title, ci, rv))
        else:
            print("  PR #%s [%s] %s" % (
                pr["number"], pr.get("status", "?"), title))


def cmd_fetch_tasks(args):
    proj = projects.get_project(args.project)
    if not proj:
        _err_project_not_found(args.project)
    task_dict = proj.get("tasks", {})
    if _emit_json_if_requested(args, task_dict): return
    for tid, t in sorted(task_dict.items()):
        _print_task_detail(
            t,
            title_line=_bold("--- %s ---" % tid),
            show_priority_group=True,
            show_ci_review=True,
            pr_title_width=60,
        )
        print()


def cmd_get_task(args):
    result = tasks.get_task(args.project, args.task_id)
    if not result:
        _err_task_not_found(args.project, args.task_id)
    if _emit_json_if_requested(args, result): return
    _print_task_detail(
        result,
        title_line=_bold(result.get("id", args.task_id)),
        show_effective=True,
        pr_title_width=50,
    )


def cmd_create_task(args):
    try:
        result = tasks.create_task(
            args.project, args.task_id,
            description=args.description or "",
            type=args.type or "feature",
            status=args.status or "not_started",
            group=args.group or "",
        )
    except KeyError:
        _err_project_not_found(args.project)
    except ValueError as e:
        _error(str(e))
    if _emit_json_if_requested(args, result): return
    print(_green("Created task '%s' in project '%s'" % (
        args.task_id, args.project)))


def cmd_update_task(args):
    # Use `is not None` so explicit --notes '' can clear a field (matches the
    # HTTP PUT semantics). Truthy checks would drop empty-string values.
    fields = {}
    if args.status is not None:
        fields["status"] = args.status
    if args.description is not None:
        fields["description"] = args.description
    if args.notes is not None:
        fields["notes"] = args.notes
    if args.priority is not None:
        fields["priority"] = args.priority
    if args.ticket_id is not None:
        fields["ticket_id"] = args.ticket_id
    if args.ticket_url is not None:
        fields["ticket_url"] = args.ticket_url
    if args.type is not None:
        fields["type"] = args.type
    if args.group is not None:
        fields["group_name"] = args.group
    if args.follow_ups is not None:
        fields["follow_ups"] = args.follow_ups
    if not fields:
        _error("no fields to update")
    result = tasks.update_task(args.project, args.task_id, **fields)
    if not result:
        _err_task_not_found(args.project, args.task_id)
    if _emit_json_if_requested(args, result): return
    print(_green("Updated task '%s'" % args.task_id))


def cmd_add_dep(args):
    _ensure_core()
    try:
        tasks.add_dependency(args.project, args.task_id, args.depends_on)
    except ValueError as e:
        # `add_dependency` raises ValueError with a "Task '<id>' not found"
        # or "Dependency target '<id>' not found" message. Surface the
        # list-tasks hint so the user can find the right id without a
        # second round-trip.
        _error(str(e), hint=_hint_list_tasks(args.project))
    print(_green("Added dependency: %s depends on %s" % (args.task_id, args.depends_on)))


def cmd_remove_dep(args):
    _ensure_core()
    try:
        tasks.remove_dependency(args.project, args.task_id, args.depends_on)
    except ValueError as e:
        _error(str(e), hint=_hint_list_tasks(args.project))
    print(_green("Removed dependency: %s no longer depends on %s" % (args.task_id, args.depends_on)))


def cmd_close_task(args):
    result = tasks.close_task(args.project, args.task_id,
                              reason=args.reason or "")
    if not result:
        _err_task_not_found(args.project, args.task_id)
    if _emit_json_if_requested(args, result): return
    print(_green("Closed task '%s'" % args.task_id))


def cmd_check_status(args):
    result = tasks.check_status(args.project, args.task_id)
    if not result:
        _err_task_not_found(args.project, args.task_id)
    if _emit_json_if_requested(args, result): return
    if result.get("changed"):
        print(_yellow("Status changed: %s -> %s" % (
            result["old_status"], result["new_status"])))
    else:
        print(_dim("Status unchanged: %s" % result["old_status"]))


def cmd_append_history(args):
    """Append one terse line to a task's history timeline (<=100 chars)."""
    text = (args.text or "").strip()
    if not text:
        _error("history text is empty",
               hint='Example: eva-cli append-history proj-x task-y "finished tests, all green"')
    try:
        entry = tasks.append_history(args.project, args.task_id, text)
    except ValueError as e:
        msg = str(e)
        if "not found" in msg:
            _error(msg, hint=_hint_list_tasks(args.project))
        if "chars" in msg:
            _error(msg,
                   hint="Trim to one terse line; longer context belongs in PR description / design doc.")
        _error(msg)
    if _emit_json_if_requested(args, entry): return
    print(_green("history+ ") + _dim("[%s]" % entry["ts"]) + " " + entry["text"])


def cmd_list_history(args):
    """Print a task's recent history timeline."""
    entries = tasks.list_history(args.project, args.task_id,
                                 limit=getattr(args, "limit", 50))
    if _emit_json_if_requested(args, {"history": entries}): return
    if not entries:
        print(_dim("(no history yet)"))
        return
    for e in entries:
        print(_dim("[%s]" % e["ts"]) + " " + e["text"])



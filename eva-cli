def _add_project_arg(p):
    """Add the positional `project` argument -- same help text on every
    subcommand, factored out so the wording can't drift."""
    p.add_argument("project", help="project ID")
    return p


def _add_task_arg(p):
    """Add the positional `task_id` argument -- paired with `project` on
    almost every task-scoped subcommand."""
    p.add_argument("task_id", help="task ID")
    return p


def _add_project_task_args(p):
    """Shorthand for the `project + task_id` pair used by most task /
    session / history / PR subcommands."""
    _add_project_arg(p)
    _add_task_arg(p)
    return p


def build_parser():
    parser = _EvaCLIParser(
        prog="eva-cli",
        description=(
            "Eva project dashboard CLI. Every command supports --json for "
            "machine-readable output. Errors go to stderr with 'Error: <msg>' "
            "and a non-zero exit code; hints (when present) follow on the next "
            "line. See `eva-cli help` for the full command list."
        ),
    )
    parser.add_argument("--json", action="store_true", default=False,
                        help="output as JSON")

    sub = parser.add_subparsers(dest="command", help="command")

    # -- Task commands --
    sub.add_parser("list-projects", help="list all projects with stats")

    p = sub.add_parser("update-project", help="update project fields")
    _add_project_arg(p)
    p.add_argument("--name")
    p.add_argument("--description")
    p.add_argument("--repo")
    p.add_argument("--jira")
    p.add_argument("--has-tickets")
    p.add_argument("--design-doc")

    p = sub.add_parser(
        "list-tasks",
        help="list tasks in a project (compact, one row per task)",
    )
    _add_project_arg(p)

    p = sub.add_parser(
        "fetch-tasks",
        help="dump full task detail for a project (multi-line per task)",
    )
    _add_project_arg(p)

    _add_project_task_args(sub.add_parser("get-task", help="get single task details"))

    p = sub.add_parser("create-task", help="create a new task")
    _add_project_task_args(p)
    p.add_argument("--description", default="")
    p.add_argument("--type", default="feature", choices=_TASK_TYPE_CHOICES)
    p.add_argument("--status", default="not_started", choices=_TASK_STATUS_CHOICES)
    p.add_argument("--group", default="")

    p = sub.add_parser("update-task", help="update task fields")
    _add_project_task_args(p)
    p.add_argument("--status", choices=_TASK_STATUS_CHOICES)
    p.add_argument("--description")
    p.add_argument("--notes")
    p.add_argument("--priority", type=int)

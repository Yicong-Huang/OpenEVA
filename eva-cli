def cmd_sync_prs(args):
    gen = prs.sync_prs_generator(full=args.full)
    total_discovered = 0
    total_updated = 0
    for progress in gen:
        phase = progress.get("phase", "")
        if _emit_jsonl_event(args, progress):
            if phase == "done":
                return
            continue
        if phase == "start":
            print(_bold("Syncing PRs...") + (
                " (full)" if progress.get("full") else ""))
        elif phase == "dirty":
            cnt = progress.get("count", 0)
            if cnt:
                print("  Updating %d dirty PRs..." % cnt)
        elif phase == "dirty_update":
            cur = progress.get("current", 0)
            tot = progress.get("total", 0)
            _print_progress("  Dirty PRs", cur, tot)
        elif phase == "discover":
            total_discovered = progress.get("discovered", 0)
            print("  Discovered %d new PRs" % total_discovered)
        elif phase == "update":
            cur = progress.get("current", 0)
            tot = progress.get("total", 0)
            total_updated = progress.get("updated", 0)
            _print_progress("  Updating", cur, tot)
        elif phase == "done":
            total_updated = progress.get("updated", 0)
            total = progress.get("total", 0)
            print(_green("\nDone: %d discovered, %d updated, %d total"
                         % (total_discovered, total_updated, total)))


def _print_progress(label, current, total):
    """Print a simple progress bar."""
    if total == 0:
        return
    pct = current * 100 // total
    bar_width = 30
    filled = bar_width * current // total
    bar = "#" * filled + "-" * (bar_width - filled)
    sys.stdout.write("\r%s [%s] %d/%d (%d%%)" % (label, bar, current, total, pct))
    sys.stdout.flush()
    if current >= total:
        sys.stdout.write("\n")


